{
    "schemaVersion": 1,
    "id": "fish_n_ships",
    "version": "${version}",

    "name": "Fish N' Ships",
    "description": "A mod that adds new boats and ships to Minecraft",

    "authors": [
        "Hybrid Labs"
    ],

    "contact": {
        "sources": "https://github.com/hybridlabs/fish-n-ships",
        "issues": "https://github.com/hybridlabs/fish-n-ships/issues"
    },

    "license": "ARR",
    "icon": "assets/fish_n_ships/icon.png",

    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "dev.hybridlabs.fishnships.FishNShips",
                "adapter": "kotlin"
            }
        ],
        "client": [
            {
                "value": "dev.hybridlabs.fishnships.FishNShipsClient",
                "adapter": "kotlin"
            }
        ],
        "fabric-datagen": [
            {
                "value": "dev.hybridlabs.fishnships.data.FSDataGenerator",
                "adapter": "kotlin"
            }
        ],
        "preLaunch": [
            "com.llamalad7.mixinextras.MixinExtrasBootstrap::init"
        ]
    },

    "mixins": [
        "fish_n_ships.fabric.mixins.json"
    ],

    "accessWidener": "fish_n_ships.accesswidener",

  "depends": {
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-language-kotlin": "*",
    "fabric-api": ">=0.92",
    "geckolib": ">=4.4",
    "hapi": ">=1.1.0"
    }
}
